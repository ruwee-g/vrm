{
  "name": "vrmapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pre": "VITE_CHANNEL=prerelease VITE_DEV_PORT=1421 vite",
    "build": "tsc && vite build",
    "build:pre": "VITE_CHANNEL=prerelease npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:pre": "VITE_CHANNEL=prerelease tauri dev --config src-tauri/tauri.prerelease.conf.json --features prerelease",
    "tauri:build:pre": "VITE_CHANNEL=prerelease RUSTFLAGS=\"--remap-path-prefix=$HOME=/home/user\" tauri build --config src-tauri/tauri.prerelease.conf.json --features prerelease",
    "release:pre": "node scripts/release-pre.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.6.0",
    "@pixiv/three-vrm-animation": "^3.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
