{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vrmapp",
  "version": "0.1.0",
  "identifier": "com.ruwee.vrmapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vrmapp",
        "width": 470,
        "height": 680,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/crispasr-macos-arm64/crispasr",
      "resources/crispasr-macos-arm64/libc2pa_c.dylib",
      "resources/crispasr-macos-arm64/LICENSE",
      "resources/crispasr-macos-arm64/THIRD_PARTY_NOTICES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}